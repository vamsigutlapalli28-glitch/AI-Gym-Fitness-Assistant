# ==============================================================================
# AI GYM & FITNESS ASSISTANT — ROOT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fitness_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/fitness_db
GEMINI_API_KEY=YOUR_ACTUAL_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
JWT_SECRET_KEY=replace-with-a-strong-random-jwt-secret-key
JWT_EXPIRE_HOURS=72
