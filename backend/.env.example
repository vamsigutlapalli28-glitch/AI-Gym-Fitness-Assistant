# ==============================================================================
# AI GYM & FITNESS ASSISTANT — BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to backend/.env and fill in your PostgreSQL & Gemini credentials.
# ==============================================================================

# --- PostgreSQL 18 Persistent Database (fitness_db) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fitness_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/fitness_db

# --- Google Gemini AI (Official google-genai SDK) ---
GEMINI_API_KEY=YOUR_ACTUAL_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- Authentication & Security ---
JWT_SECRET_KEY=replace-with-a-strong-random-jwt-secret-key
JWT_EXPIRE_HOURS=72

# --- Optional SMTP Email Configuration for Password Reset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aigymassistant.local
